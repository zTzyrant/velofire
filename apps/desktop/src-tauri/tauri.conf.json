{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velofire",
  "version": "0.1.0",
  "identifier": "dev.velofire.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velofire",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
